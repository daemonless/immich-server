      io.daemonless.volumes="/config,/data" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

# Install runtime dependencies (Intel and AMD VA-API drivers only needed on amd64)
RUN case "${FREEBSD_ARCH}" in \
        amd64) ARCH_PACKAGES="libva-intel-media-driver mesa-dri" ;; \
        *)     ARCH_PACKAGES="" ;; \
    esac && \
    pkg update && \
    pkg install -y ${PACKAGES} ${ARCH_PACKAGES} && \
    mkdir -p /app && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    find /usr/local -name '*.a' -delete && \
    rm -rf /usr/local/share/doc /usr/local/share/man /usr/local/include /usr/local/llvm19/include /usr/local/llvm19/bin && \
    rm -rf /usr/local/libexec/gcc14 /usr/local/bin/*-portbld-freebsd* /usr/local/*-portbld-freebsd* && \
    rm -f /usr/local/lib/libopcodes* /usr/local/lib/libbfd*

# Link jellyfin-ffmpeg (HDR tonemapping) to default ffmpeg paths
RUN ln -sf /usr/local/lib/jellyfin-ffmpeg8/bin/ffmpeg  /usr/local/bin/ffmpeg && \
    ln -sf /usr/local/lib/jellyfin-ffmpeg8/bin/ffprobe /usr/local/bin/ffprobe && \
    ln -sf /usr/local/lib/jellyfin-ffmpeg8/bin/ffmpeg  /usr/local/bin/jellyfin-ffmpeg && \
    ln -sf /usr/local/lib/jellyfin-ffmpeg8/bin/ffprobe /usr/local/bin/jellyfin-ffprobe

# Copy version and built application from builder
COPY --from=builder /tmp/immich_version /tmp/immich_version
COPY --from=builder --chown=bsd:bsd /app /app

# Fix builder umask (COPY --chown preserves restrictive 700/600 from build stage)
RUN chmod -R a+rX /app

# Create directories, write version, and symlinks (paths match Linux immich expectations)
RUN cp /tmp/immich_version /app/version && \
    mkdir -p /config /data /build && \
    mkdir -p /data/{encoded-video,thumbs,upload,profile,backups,library} && \
    chown -R bsd:bsd /config /data /build && \
    chmod 755 /build && \
    ln -sf /app/www /build/www && \
    mkdir -p /build/plugins && \
    chown bsd:bsd /build/plugins && chmod 755 /build/plugins && \
    ln -sf /app/corePlugin /build/plugins/immich-plugin-core && \
    ln -sf /app/geodata /build/geodata && \
    chown -h bsd:bsd /build/www /build/plugins/immich-plugin-core /build/geodata && \
    for v in 14 15 16 17 18; do \
      mkdir -p /usr/lib/postgresql/${v}/bin && \
      ln -sf /usr/local/bin/pg_dump /usr/lib/postgresql/${v}/bin/pg_dump; \
      ln -sf /usr/local/bin/pg_dumpall /usr/lib/postgresql/${v}/bin/pg_dumpall; \
      ln -sf /usr/local/bin/psql /usr/lib/postgresql/${v}/bin/psql; \
    done && \
    chmod -R a+rX /usr/lib/postgresql

# Copy service files
COPY root/ /
RUN chmod +x /etc/services.d/*/run /etc/cont-init.d/* 2>/dev/null || true

WORKDIR /app

